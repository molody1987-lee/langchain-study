// LangGraph Flow
digraph {
	rankdir=LR
	__start__ [label=START shape=circle]
	generate [label=generate shape=box]
	risky [label=risky shape=box]
	classify [label=classify shape=box]
	handle_positive [label=handle_positive shape=box]
	handle_negative [label=handle_negative shape=box]
	human_review [label=human_review shape=box]
	__end__ [label=END shape=doublecircle]
	__start__ -> generate [label=""]
	classify -> handle_negative [label="" style=dashed]
	classify -> handle_positive [label="" style=dashed]
	classify -> human_review [label="" style=dashed]
	generate -> risky [label=""]
	risky -> classify [label=""]
	handle_negative -> __end__ [label=""]
	handle_positive -> __end__ [label=""]
	human_review -> __end__ [label=""]
}
